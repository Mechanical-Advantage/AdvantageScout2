{
  "name": "advantagescout2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "concurrently -n web,api -c blue,green \"npm run dev\" \"node scripts/run-server.mjs server/http_server.py --reload\"",
    "web": "node scripts/run-server.mjs server/http_server.py --reload",
    "bridge": "node scripts/run-server.mjs server/bluetooth_server.py --base-url http://127.0.0.1:6328",
    "full": "concurrently -n api,ble -c green,magenta \"node scripts/run-server.mjs server/http_server.py --reload\" \"node scripts/run-server.mjs server/bluetooth_server.py --base-url http://127.0.0.1:6328\"",
    "build": "vite build",
    "postbuild": "node scripts/stamp-version.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "cap:sync": "cap sync android",
    "android:build": "npm run build && npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:install": "adb install -r app/build/outputs/apk/debug/app-debug.apk"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.4",
    "svelte-spa-router": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.5.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.4",
    "concurrently": "^9.1.0",
    "daisyui": "^5.7.27",
    "sharp": "^0.35.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
